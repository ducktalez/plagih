\backslash
frac{1}{n}
\backslash
sum_{i=1}^{n}(y_{i}-
\backslash
hat{y}_{i})
\backslash

\backslash
 
\end_layout

\begin_layout Plain Layout


\backslash
text{MSE} & = & 
\backslash
frac{1}{n}
\backslash
sum_{i=1}^{n}(y_{i}-
\backslash
hat{y}_{i})^{2} 
\end_layout

\begin_layout Plain Layout


\backslash
