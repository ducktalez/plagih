# plagih GP Framework — Environment Configuration
# Copy to `.env` and adjust. Code-level params override these.
# Defaults = minimal profile (safe starting point).

# Verbosity: printpl(level, msg) prints if `level in VERBOSITY`.
# Full: "wwwwaaaggggiiiifffpp"  Silent: ""
PLAGIH_VERBOSITY=wwaaggiiffpp
PLAGIH_DEBUG=false

# GP Feature Flags (Recommended values in parentheses)
PLAGIH_SIMPLIFICATION=false    # (true)  SymPy tree simplification
PLAGIH_VISUALIZATION=false     # (true)  Monitoring plots & renderings
PLAGIH_MERGED_TREE=false       # (false) Merged population tree per gen
PLAGIH_ORIGIN_TREE=false       # (false) Track origin-tree metadata
PLAGIH_LUT_ENABLED=true        # Expression LUT for dedup — big speedup
PLAGIH_PARALLEL=0              # (4–8)   0 = sequential, N = worker processes

# Numeric / IO
PLAGIH_FLOAT_PRECISION=3
PLAGIH_PLOTS_INTERVAL=1
PLAGIH_BACKUP_INTERVAL=10
PLAGIH_TREE_MIN_PARSIMONY=3
