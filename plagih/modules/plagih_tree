def load_from_expression( expr):
    """
    Loads
    Ifte(observation1 < 0, 0, Ifte(observation1 > -0.31764124474209838, 2, 0))
    """
    tree = ast.parse(expr, mode='eval').body
    eval_expr(tree)

def eval_expr(self, tree):

    """
    Recursively transforms parsed expression tree into TensorFlow (TF) graph.

    """

    if isinstance(tree, ast.Name):  # <tensor_name>
        print('DBG: '+str(ast.Name))
        tmp = str(ast.Name)
        return tmp

    elif isinstance(tree, ast.Num):  # <number>
        print('DBG: '+str(tree.n))
        tmp = str(tree.n)
        return tmp

    elif isinstance(tree, ast.BinOp):  # <left> <operator> <right>, e.g., x + y
        print('DBG: '+eval_expr(tree.left) + str(op_str[type(tree.op)]) + eval_expr(tree.right))
        return eval_expr(tree.left) + op_str[type(tree.op)] + eval_expr(tree.right)

    elif isinstance(tree, ast.UnaryOp):  # <operator> <operand> e.g., -1
        print('DBG: '+op_str[type(tree.op)])
        return eval_expr(tree.operand)

    elif isinstance(tree, ast.Call):  # <function>(<arguments>) e.g., sin(x) -> or if(a, b, c) -> or Ftob(a)

        if tree.func.id == 'Ifte':
            print('DBG: '+tree.func.id)
            return eval_expr(tree.args[0]), eval_expr(tree.args[1]), eval_expr(tree.args[2])

        # special case: Min and Max accept 2 or more arguments. Many errors. Therefore not in use anymore.
        if tree.func.id in ['Mini', 'Maxi']:  # Min, Max are now Mini and Maxi. These only accept two inputs.
            print('DBG: '+tree.func.id + str([eval_expr(arg) for arg in tree.args]))
            return tree.func.id + str([eval_expr(arg) for arg in tree.args])

        if tree.func.id == 'Ftob':
            return eval_expr([eval_expr(arg) for arg in tree.args])
        elif tree.func.id == 'Btof':
            print('DBG: '+'Btof' + str([eval_expr(arg) for arg in tree.args]) + ')')

        print('DBG: '+tree.func.id + [eval_expr(arg) for arg in tree.args])
        return tree.func.id + [eval_expr(arg) for arg in tree.args]

    elif isinstance(tree, ast.Compare):  # <left> <compare> <right> e.g., a > z
        print('DBG: '+'')
        return  # eval_tf_chain_compare([tree.left] + tree.comparators, tree.ops)

    elif isinstance(tree, ast.NameConstant):  # <True/False> e.g., <True>
        print('DBG: '+tree.value)
        return

