	\hbox{%
	\setbeamercolor{lmu_green}{fg=white,bg=beamer@lmu_green!75}
		\begin{beamercolorbox}[wd=.2\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
			\usebeamerfont{title in head/foot}\insertauthor
		\end{beamercolorbox}%
		\begin{beamercolorbox}[wd=.6\paperwidth,ht=2.25ex,dp=1ex,center]{lmu_green}%
			\usebeamerfont{title in head/foot}
			\insertshorttitle
		\end{beamercolorbox}%
		\begin{beamercolorbox}[wd=.2\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
			%\usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}
			\progressbar@progressbar%
			%\hfill
			%\insertframenumber{}\hspace*{2ex} 
	\end{beamercolorbox}}%
	\vskip0pt%
}
\makeatother
%%% END FOOTER

% Disable Navigation Symbols
\beamertemplatenavigationsymbolsempty

% Add chapter numbers to TOC
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{subsection in toc}[subsections numbered]

% Set shading of non-active sections
\setbeamertemplate{section in toc shaded}[default][40]
\setbeamertemplate{subsection in toc shaded}[default][40]

% Show TOC before every subsection, where only the current section is expanded.
\setbeamertemplate{subsection page}{%
	\tableofcontents[
        currentsection,
        currentsubsection,
        subsectionstyle=show/shaded/hide,
	]
}